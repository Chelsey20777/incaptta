{
  "name": "incaptta-web",
  "version": "1.0.0",
  "description": "Incaptta Agri-Structures - Vue 3 PWA Marketing Website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "npm run generate:sitemap && vue-tsc && vite build",
    "preview": "vite preview",
    "start": "serve dist -s -l ${PORT:-8080}",
    "deploy": "npm run build && firebase deploy --only hosting:www"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@vueuse/head": "^2.0.0",
    "@vueuse/motion": "^2.2.3",
    "firebase": "^11.0.0",
    "lucide-vue-next": "^0.454.0",
    "serve": "^14.2.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vue-tsc": "^2.1.0"
  }
}
