# Incaptta Web Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - it contains sensitive keys

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=incaptta-pro.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=incaptta-pro
VITE_FIREBASE_STORAGE_BUCKET=incaptta-pro.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
