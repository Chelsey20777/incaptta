# Safe local defaults. These values intentionally do not reference production.
DEPLOYMENT_ENV=development
NEXT_PUBLIC_DEPLOYMENT_ENV=development
FIREBASE_PROJECT_ID=demo-incaptta
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-incaptta.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-incaptta
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-incaptta.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:development
LEGACY_API_BASE_URL=http://127.0.0.1:5001/demo-incaptta/us-central1/api
ALLOW_REAL_EMAIL=false
ENABLE_SCHEDULED_JOBS=false
